# ============================================================
# GasPrice — Supabase/Postgres via variáveis de ambiente
# ============================================================
# COMO USAR:
#   1. Crie um projeto em https://supabase.com/dashboard (é grátis)
#   2. No painel do projeto, acesse: Project Settings > API
#   3. Copie este arquivo para ".env" e preencha os valores abaixo.
#      O arquivo ".env" NÃO é versionado (está no .gitignore).
#   4. Antes de usar, rode no SQL Editor do Supabase o arquivo
#      "supabase_schema.sql" (cria as tabelas) e depois
#      "supabase_seed.sql" (dados iniciais).
#   5. Localmente: basta rodar "python server.py" — o .env é carregado.
#      Na Vercel: adicione as mesmas variáveis em
#      Project > Settings > Environment Variables.
# ============================================================
# SEM estas variáveis, o app continua usando SQLite local (gasprice.db).

# URL do projeto (ex: https://abcdefghijkl.supabase.co)
SUPABASE_URL=

# Service Role Key — recomendada para o backend (ignora RLS).
# Fica em Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Anon Key — usada apenas se a Service Role Key não estiver definida.
# Fica em Project Settings > API > anon public
SUPABASE_ANON_KEY=

# Referência do projeto (opcional, apenas informativo)
SUPABASE_PROJECT_REF=
